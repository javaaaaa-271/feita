{
  "name": "projeto-vitrine-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vinext dev --port 5173 --hostname 0.0.0.0",
    "build": "bash scripts/build-verified.sh",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/order-flow.test.mjs tests/storefront.test.mjs tests/local-persistence.test.mjs tests/worker-deployment.test.mjs tests/worker-closed-gate.test.mjs && node --import tsx --test tests/email.test.ts tests/authentication.test.ts tests/onboarding.test.ts tests/catalog.test.ts tests/public-media.test.ts tests/images-binding-spike.test.ts tests/product-images.test.ts tests/worker-trial-guard.test.ts",
    "test:images-spike": "node --import tsx --test tests/images-binding-spike.test.ts",
    "spike:images:fixtures": "node spikes/images-binding/generate-fixtures.mjs",
    "spike:images:probe": "node spikes/images-binding/run-probe.mjs",
    "test:marco4": "node --test tests/storefront.test.mjs tests/local-persistence.test.mjs",
    "worker:dry-run": "bash scripts/worker-deploy-dry-run.sh",
    "worker:closed-gate": "node scripts/worker-closed-gate.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern spikes/images-binding/.wrangler",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply feita-local --local",
    "store:import": "node scripts/import-store.mjs"
  },
  "dependencies": {
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "miniflare": "4.20260722.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.2"
  },
  "type": "module",
  "displayName": "Projeto Vitrine — MVP"
}
